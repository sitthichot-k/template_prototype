# =============================================================================
#  PREPRODUCTION / STAGING  -  docker compose --env-file .env.preproduction
#  Mirror of production topology with non-production data.
#  All CHANGE_ME values must be injected by the secret manager or CI, never
#  hand-edited into a file that could be committed.
# =============================================================================

PROJECT_CODE=myapp
PROJECT_NAME=MyApp
PROJECT_DESCRIPTION=Enterprise application generated from the platform template.
PROJECT_VERSION=1.0.0
COMPOSE_PROJECT_NAME=myapp-preprod

APP_ENV=preproduction
NODE_ENV=production

BACKEND_ENV_FILE=./backend-node/.env.preproduction
FRONTEND_ENV_FILE=./frontend-vue/.env.preproduction
FRONTEND_CONTEXT=./frontend-vue

# Behind a reverse proxy: application ports stay on loopback.
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8081
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8080
# Datastores are NOT published to the host in this tier.
MONGO_BIND_IP=127.0.0.1
MONGO_PORT=27017
REDIS_BIND_IP=127.0.0.1
REDIS_PORT=6379

MONGO_DATABASE=myapp_preprod
MONGO_ROOT_USERNAME=CHANGE_ME
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_APP_USERNAME=CHANGE_ME
MONGO_APP_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME

REGISTRY=registry.example.com
IMAGE_NAMESPACE=platform
IMAGE_TAG=preprod

BACKEND_CPU_LIMIT=2
BACKEND_MEMORY_LIMIT=2g
FRONTEND_CPU_LIMIT=1
FRONTEND_MEMORY_LIMIT=512m

# --- Content-Security-Policy extension points --------------------------------
# Widen only what this project genuinely loads from outside its own origin.
# Space-separated. Baked into the frontend image at build time; the policy
# itself lives in infra/nginx/default.conf.
CSP_IMG_SRC_EXTRA=
CSP_CONNECT_SRC_EXTRA=
CSP_FONT_SRC_EXTRA=
