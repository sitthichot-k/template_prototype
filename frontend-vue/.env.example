# =============================================================================
#  FRONTEND ENVIRONMENT - reference copy (the only one committed).
#
#  WARNING: every VITE_* value is embedded in the JavaScript bundle and is
#  therefore PUBLIC. Never put a secret here. Anything the browser must not
#  see belongs in the backend env and is reached through the API.
#
#  Copy to .env.local / .env.preproduction / .env.production.
# =============================================================================

# Empty means same-origin, which is how preproduction and production run:
# nginx proxies /api to the backend, so the browser never makes a cross-origin
# request and CORS is not involved.
VITE_API_BASE_URL=
VITE_API_PREFIX=/api/v1

# Used by the Vite dev server proxy only; not part of the bundle.
VITE_DEV_API_TARGET=http://127.0.0.1:8081

VITE_APP_NAME=MyApp
VITE_DEFAULT_LOCALE=en
