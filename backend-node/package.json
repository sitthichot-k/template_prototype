{
  "name": "__PROJECT_CODE__-api",
  "version": "1.0.0",
  "private": true,
  "description": "__PROJECT_DESCRIPTION__",
  "main": "server.js",
  "engines": {
    "node": ">=20.11 <23"
  },
  "scripts": {
    "start": "node -r dotenv/config server.js",
    "start:dev": "nodemon --inspect=0.0.0.0:9229 -r dotenv/config server.js",
    "start:local": "cross-env DOTENV_CONFIG_PATH=.env.local nodemon -r dotenv/config server.js",
    "start:preproduction": "cross-env DOTENV_CONFIG_PATH=.env.preproduction node -r dotenv/config server.js",
    "start:production": "cross-env DOTENV_CONFIG_PATH=.env.production node -r dotenv/config server.js",

    "seed": "node -r dotenv/config scripts/seed.js",
    "seed:local": "cross-env DOTENV_CONFIG_PATH=.env.local node -r dotenv/config scripts/seed.js",
    "migrate": "node -r dotenv/config scripts/migrate.js up",
    "migrate:down": "node -r dotenv/config scripts/migrate.js down",
    "migrate:status": "node -r dotenv/config scripts/migrate.js status",

    "sync:permissions": "node -r dotenv/config scripts/sync-permissions.js",
    "policy:recover": "node -r dotenv/config scripts/policy-recover.js",
    "make:module": "node scripts/make-module.js",
    "verify:modules": "node scripts/verify-module-contracts.js",

    "lint": "eslint . --ext .js --max-warnings 0",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",

    "test": "cross-env NODE_ENV=test node scripts/run-tests.js",
    "test:watch": "cross-env NODE_ENV=test node scripts/run-tests.js --watch",
    "test:coverage": "cross-env NODE_ENV=test node scripts/run-tests.js --experimental-test-coverage"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "axios": "^1.7.9",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.9.5",
    "multer": "^2.0.1",
    "nanoid": "^3.3.8",
    "nodemailer": "^6.9.16",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limit-redis": "^4.2.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  }
}
