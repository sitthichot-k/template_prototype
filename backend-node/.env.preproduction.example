# =============================================================================
#  BACKEND - PREPRODUCTION / STAGING
#
#  Every CHANGE_ME is injected at deploy time from the secret manager.
#  ./scripts/compose.sh refuses to start this tier while any remain.
# =============================================================================

NODE_ENV=production
APP_ENV=preproduction
PORT=8080
TRUST_PROXY=1

PROJECT_CODE=myapp
PROJECT_NAME=MyApp
PROJECT_DESCRIPTION=Enterprise application generated from the platform template.
PROJECT_VERSION=1.0.0
PROJECT_ORGANIZATION=
# Seed values for the branding/localisation settings. An administrator can
# change them at runtime; these only decide what a fresh deployment starts as.
BRANDING_PRIMARY_COLOR=#2563eb
DEFAULT_LOCALE=en

MONGO_URI=CHANGE_ME
MONGO_MAX_POOL_SIZE=30
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

REDIS_URL=CHANGE_ME
REDIS_KEY_PREFIX=myapp:preprod:

API_PREFIX=/api/v1
# Served same-origin through nginx, so only tooling origins belong here.
CORS_ORIGINS=https://preprod.myapp.example.com
BODY_LIMIT=2mb
REQUEST_TIMEOUT_MS=30000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

JWT_ACCESS_SECRET=CHANGE_ME
JWT_ISSUER=myapp
JWT_AUDIENCE=myapp-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

COOKIE_SECRET=CHANGE_ME
COOKIE_DOMAIN=preprod.myapp.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

ENCRYPTION_KEY=CHANGE_ME

PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_SIZE=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

SESSION_ABSOLUTE_TIMEOUT_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=60

IDENTITY_PROVIDERS=local
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPE=openid profile email

LOG_LEVEL=info
LOG_PRETTY=false
LOG_REDACT_EXTRA=
# Kept on so QA can exercise the contract; off in production.
SWAGGER_ENABLED=true
METRICS_ENABLED=true

AUDIT_RETENTION_DAYS=180

MODULES_ENABLED=
MODULES_DISABLED=

BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
