# =============================================================================
#  BACKEND - PRODUCTION
#
#  SECURITY CONTRACT
#  1. No plaintext secret is ever written here by hand. The deploy pipeline
#     resolves each CHANGE_ME from the secret manager and writes a 0600 file.
#  2. Covered by .gitignore. If this file reaches a commit, treat every value
#     in it as compromised and rotate.
#  3. Rotating ENCRYPTION_KEY requires re-encrypting stored secret settings -
#     see docs/guides/secrets-management.md before changing it.
# =============================================================================

NODE_ENV=production
APP_ENV=production
PORT=8080
TRUST_PROXY=1

PROJECT_CODE=myapp
PROJECT_NAME=MyApp
PROJECT_DESCRIPTION=Enterprise application generated from the platform template.
PROJECT_VERSION=1.0.0
PROJECT_ORGANIZATION=
# Seed values for the branding/localisation settings. An administrator can
# change them at runtime; these only decide what a fresh deployment starts as.
BRANDING_PRIMARY_COLOR=#2563eb
DEFAULT_LOCALE=en

MONGO_URI=CHANGE_ME
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

REDIS_URL=CHANGE_ME
REDIS_KEY_PREFIX=myapp:prod:

API_PREFIX=/api/v1
# REQUIRED: the process refuses to start in production with this unset.
CORS_ORIGINS=https://myapp.example.com
BODY_LIMIT=2mb
REQUEST_TIMEOUT_MS=30000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=5

JWT_ACCESS_SECRET=CHANGE_ME
JWT_ISSUER=myapp
JWT_AUDIENCE=myapp-api
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL_DAYS=7

COOKIE_SECRET=CHANGE_ME
COOKIE_DOMAIN=myapp.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

ENCRYPTION_KEY=CHANGE_ME

PASSWORD_MIN_LENGTH=14
PASSWORD_HISTORY_SIZE=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

SESSION_ABSOLUTE_TIMEOUT_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=30

IDENTITY_PROVIDERS=local
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPE=openid profile email

LOG_LEVEL=warn
LOG_PRETTY=false
LOG_REDACT_EXTRA=
# Off by contract: the schema enumerates every endpoint and permission.
SWAGGER_ENABLED=false
METRICS_ENABLED=true

AUDIT_RETENTION_DAYS=365

MODULES_ENABLED=
MODULES_DISABLED=

BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME
BOOTSTRAP_ADMIN_NAME=Administrator
# Leave empty: a generated password is printed once during the seed run.
BOOTSTRAP_ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
