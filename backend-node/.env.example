# =============================================================================
#  BACKEND ENVIRONMENT - reference copy (the only one committed to git).
#
#  Every variable the backend reads is declared in config/index.js and
#  validated at boot. A missing required value fails startup rather than the
#  first request that needs it.
#
#  Copy to .env.local / .env.preproduction / .env.production and fill in.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
PORT=8080
# 'loopback' locally; '1' behind a single reverse proxy.
TRUST_PROXY=loopback

# --- Project identity --------------------------------------------------------
PROJECT_CODE=myapp
PROJECT_NAME=MyApp
PROJECT_DESCRIPTION=Enterprise application generated from the platform template.
PROJECT_VERSION=1.0.0
PROJECT_ORGANIZATION=
# Seed values for the branding/localisation settings. An administrator can
# change them at runtime; these only decide what a fresh deployment starts as.
BRANDING_PRIMARY_COLOR=#2563eb
DEFAULT_LOCALE=en

# --- Datastores --------------------------------------------------------------
# Compose overrides both of these with in-network service names.
MONGO_URI=mongodb://myapp_app:CHANGE_ME@127.0.0.1:27017/myapp_local?authSource=myapp_local
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
REDIS_KEY_PREFIX=myapp:

# --- HTTP --------------------------------------------------------------------
API_PREFIX=/api/v1
# Comma-separated allowlist. REQUIRED in production - boot fails without it.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
BODY_LIMIT=2mb
REQUEST_TIMEOUT_MS=30000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Authentication ----------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_random_value_here
JWT_ISSUER=myapp
JWT_AUDIENCE=myapp-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

COOKIE_SECRET=CHANGE_ME_min_16_chars
COOKIE_DOMAIN=
# true whenever the site is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# AES-256-GCM key for settings marked secret. Rotating it requires
# re-encrypting stored values - see docs/guides/secrets-management.md.
ENCRYPTION_KEY=CHANGE_ME_min_32_chars_random_value_here

PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_SIZE=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

SESSION_ABSOLUTE_TIMEOUT_HOURS=720
SESSION_IDLE_TIMEOUT_MINUTES=60

# --- Identity providers ------------------------------------------------------
# Comma-separated. 'local' is always available; add 'oidc' for SSO.
IDENTITY_PROVIDERS=local
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPE=openid profile email

# --- Observability -----------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
# Extra pino redaction paths, comma-separated.
LOG_REDACT_EXTRA=
SWAGGER_ENABLED=true
METRICS_ENABLED=true

# --- Compliance --------------------------------------------------------------
AUDIT_RETENTION_DAYS=365

# --- Modules -----------------------------------------------------------------
# Empty MODULES_ENABLED loads everything found on disk.
MODULES_ENABLED=
MODULES_DISABLED=

# --- Bootstrap seed ----------------------------------------------------------
# Consumed only by `npm run seed`, and only when the database has no users.
# Leave the password unset to have one generated and printed once.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=

# --- Mail --------------------------------------------------------------------
# Operational fallback only. Mail is normally configured at runtime through
# the settings module so it can change without a redeploy.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
