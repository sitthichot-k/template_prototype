# =============================================================================
#  ROOT COMPOSE ENVIRONMENT - reference / documentation copy
#  This is the ONLY env file committed to git. Copy it to create the real ones:
#     cp .env.example .env.local
#     cp .env.example .env.preproduction
#     cp .env.example .env.production
#  Never commit the copies. See ENVIRONMENTS.md.
# =============================================================================

# --- Project identity (consumed by the generator and by every service) -------
PROJECT_CODE=myapp
PROJECT_NAME=MyApp
PROJECT_DESCRIPTION=Enterprise application generated from the platform template.
PROJECT_VERSION=1.0.0
COMPOSE_PROJECT_NAME=myapp

# --- Deployment tier: local | preproduction | production ---------------------
APP_ENV=local
NODE_ENV=development

# --- Which per-service env file compose injects ------------------------------
BACKEND_ENV_FILE=./backend-node/.env.local
FRONTEND_ENV_FILE=./frontend-vue/.env.local

# --- Frontend build context --------------------------------------------------
FRONTEND_CONTEXT=./frontend-vue

# --- Network exposure --------------------------------------------------------
# Bind to 127.0.0.1 everywhere except behind a trusted reverse proxy.
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8081
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8080
MONGO_BIND_IP=127.0.0.1
MONGO_PORT=27017
REDIS_BIND_IP=127.0.0.1
REDIS_PORT=6379

# --- MongoDB -----------------------------------------------------------------
MONGO_DATABASE=myapp
MONGO_ROOT_USERNAME=CHANGE_ME
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_APP_USERNAME=CHANGE_ME
MONGO_APP_PASSWORD=CHANGE_ME

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- Container image registry (CI/CD) ----------------------------------------
REGISTRY=registry.example.com
IMAGE_NAMESPACE=platform
IMAGE_TAG=latest

# --- Resource limits ---------------------------------------------------------
BACKEND_CPU_LIMIT=1
BACKEND_MEMORY_LIMIT=1g
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEMORY_LIMIT=512m

# --- Content-Security-Policy extension points --------------------------------
# Widen only what this project genuinely loads from outside its own origin.
# Space-separated. Baked into the frontend image at build time; the policy
# itself lives in infra/nginx/default.conf.
CSP_IMG_SRC_EXTRA=
CSP_CONNECT_SRC_EXTRA=
CSP_FONT_SRC_EXTRA=
