# =============================================================================
#  PRODUCTION  -  docker compose --env-file .env.production
#
#  SECURITY CONTRACT
#  1. This file holds NO plaintext secrets. Every CHANGE_ME is resolved at
#     deploy time from the secret manager (Vault / GitLab masked variables /
#     AWS Secrets Manager) and written to a 0600 file owned by the deploy user.
#  2. The file must never be committed. It is covered by .gitignore.
#  3. Rotate MONGO_*_PASSWORD and REDIS_PASSWORD on the schedule defined in
#     docs/guides/secrets-management.md.
# =============================================================================

PROJECT_CODE=myapp
PROJECT_NAME=MyApp
PROJECT_DESCRIPTION=Enterprise application generated from the platform template.
PROJECT_VERSION=1.0.0
COMPOSE_PROJECT_NAME=myapp-prod

APP_ENV=production
NODE_ENV=production

BACKEND_ENV_FILE=./backend-node/.env.production
FRONTEND_ENV_FILE=./frontend-vue/.env.production
FRONTEND_CONTEXT=./frontend-vue

# Production always sits behind the edge proxy; nothing binds to 0.0.0.0.
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8081
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8080
MONGO_BIND_IP=127.0.0.1
MONGO_PORT=27017
REDIS_BIND_IP=127.0.0.1
REDIS_PORT=6379

MONGO_DATABASE=myapp
MONGO_ROOT_USERNAME=CHANGE_ME
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_APP_USERNAME=CHANGE_ME
MONGO_APP_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME

REGISTRY=registry.example.com
IMAGE_NAMESPACE=platform
IMAGE_TAG=CHANGE_ME

BACKEND_CPU_LIMIT=4
BACKEND_MEMORY_LIMIT=4g
FRONTEND_CPU_LIMIT=1
FRONTEND_MEMORY_LIMIT=512m

# --- Content-Security-Policy extension points --------------------------------
# Widen only what this project genuinely loads from outside its own origin.
# Space-separated. Baked into the frontend image at build time; the policy
# itself lives in infra/nginx/default.conf.
CSP_IMG_SRC_EXTRA=
CSP_CONNECT_SRC_EXTRA=
CSP_FONT_SRC_EXTRA=
